# Copy to .env and adjust as needed.

# Where the raw Telco churn CSV lives and where artifacts are written
RETAINIQ_DATA_DIR=./data
RETAINIQ_ARTIFACT_DIR=./artifacts

# Model that the API serves by default (logistic_regression | random_forest | xgboost)
RETAINIQ_DEFAULT_MODEL=random_forest

# SQLite by default; switch to PostgreSQL for a shared deployment, e.g.
# RETAINIQ_DATABASE_URL=postgresql+psycopg://retainiq:retainiq@localhost:5432/retainiq
RETAINIQ_DATABASE_URL=sqlite:///./artifacts/monitoring.db

# Dashboard -> API base URL
RETAINIQ_API_URL=http://localhost:8000

# Log level (DEBUG | INFO | WARNING | ERROR)
RETAINIQ_LOG_LEVEL=INFO
